# LibrIA Mobile - Configurações de Ambiente
# Copie este arquivo para .env e ajuste as configurações

# API Backend
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30000

# Configurações da Câmera
CAMERA_RESOLUTION=720p
CAMERA_FPS=30
CAMERA_FRONT_FACING=false

# Configurações de Reconhecimento
RECOGNITION_INTERVAL=1000
CONFIDENCE_THRESHOLD=0.7
MAX_PREDICTIONS_PER_SECOND=5

# Configurações de Armazenamento
MAX_HISTORY_ITEMS=100
AUTO_SAVE_INTERVAL=30000

# Configurações de Debug
DEBUG_MODE=true
LOG_LEVEL=info
SHOW_FPS_COUNTER=true

# Configurações de Notificações
ENABLE_NOTIFICATIONS=true
NOTIFICATION_SOUND=true
VIBRATION_FEEDBACK=true

# Configurações de Analytics (opcional)
ENABLE_ANALYTICS=false
FIREBASE_PROJECT_ID=your-project-id
