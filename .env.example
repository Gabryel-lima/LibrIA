# Environment Variables Example
# Copy this file to .env and fill with your values
# DO NOT commit .env to Git!

# Python Environment
PYTHON_VERSION=3.11
PYTHONPATH=./src

# Development
DEBUG=False
LOG_LEVEL=INFO

# Database (if applicable)
# DATABASE_URL=postgresql://user:password@localhost:5432/libria

# API Keys (if applicable)
# OPENAI_API_KEY=
# GOOGLE_CLOUD_API_KEY=

# Model Configuration
MODEL_PATH=./model/model.pickle
DATASET_PATH=./data/

# Camera Settings
CAMERA_INDEX=0
CAMERA_RESOLUTION=640x480

# Performance
NUM_WORKERS=4
BATCH_SIZE=32
USE_GPU=False

# Logging
LOG_FILE=./logs/libria.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Feature Flags
ENABLE_FACE_RECOGNITION=False
ENABLE_ADVANCED_ANALYTICS=False

# Email (if applicable)
# SMTP_SERVER=
# SMTP_PORT=
# SENDER_EMAIL=
# SENDER_PASSWORD=

# URLs
# API_BASE_URL=
# CALLBACK_URL=
